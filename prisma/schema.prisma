generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// 1. Tashkilot (SaaS asosi)
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ish tartibi (Toshkent vaqti): davomat, kechikish va tabel shu bo'yicha hisoblanadi
  workStartTime    String @default("08:00")
  workEndTime      String @default("18:00")
  lateGraceMinutes Int    @default(10)
  // ISO hafta kunlari: 1 = dushanba ... 7 = yakshanba
  workDays         String @default("1,2,3,4,5,6")
  // Sex joylashuvi — berilsa, xodim faqat shu radius ichida kelish/ketishni belgilay oladi
  geoLat           Float?
  geoLng           Float?
  geoRadiusM       Int?
  // Yashirilgan bo'limlar (vergul bilan): suppliers, rolls, bomProduction, sales, finance ...
  disabledModules  String @default("suppliers,rolls,bomProduction,legacy")
  // Stanokka ip qo'yilgandan necha soat o'tgach paypoq omborga (qadoqlangan) o'tadi
  autoTransferHours Int   @default(24)

  users            User[]
  products         Product[]
  warehouses       Warehouse[]
  movements        StockMovement[]
  customers        Customer[]
  sales            Sale[]
  expenses         Expense[]
  staffAdjustments StaffAdjustment[]
  rolls            Roll[]
  debtPayments     DebtPayment[]
  suppliers        Supplier[]
  supplierPayments SupplierPayment[]
  attendance       Attendance[]
  machines         Machine[]
  machineRuns      MachineRun[]
  machineEvents    MachineRunEvent[]
  devices          AttendanceDevice[]
  devicePunches    DevicePunch[]
  batches          Batch[]
  batchMovements   BatchMovement[]
  machineLoads     MachineLoad[]
  stockSales       StockSale[]
}

// 2. Foydalanuvchilar (Auth uchun)
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String
  telegramId   String? @unique
  // Profil sahifasidan bot orqali ulash uchun bir martalik token (t.me/<bot>?start=<token>)
  telegramLinkToken          String?   @unique
  telegramLinkTokenExpiresAt DateTime?
  role                       Role      @default(WORKER)
  // Bloklangan xodim tizimga kira olmaydi, ochiq sessiyalari ham bekor bo'ladi
  isActive                   Boolean   @default(true)
  // Parol almashtirilsa yoki xodim bloklansa oshiriladi — eski JWT'lar yaroqsiz bo'ladi
  sessionVersion             Int       @default(0)
  // Davomatda: qo'shilgan kundan oldingi kunlar "kelmagan" hisoblanmaydi
  createdAt                  DateTime  @default(now())
  // Face ID qurilmadagi xodim raqami (PIN)
  deviceUserId               String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  adjustments             StaffAdjustment[] @relation("StaffAdjustments")
  movements               StockMovement[]   @relation("WorkerMovements")
  createdMovements        StockMovement[]   @relation("CreatorMovements")
  createdSales            Sale[]            @relation("SaleCreator")
  cancelledSales          Sale[]            @relation("SaleCanceller")
  createdExpenses         Expense[]         @relation("ExpenseCreator")
  createdDebtPayments     DebtPayment[]     @relation("DebtPaymentCreator")
  createdAdjustments      StaffAdjustment[] @relation("AdjustmentCreator")
  createdSupplierPayments SupplierPayment[] @relation("SupplierPaymentCreator")
  attendance              Attendance[]      @relation("AttendanceUser")
  editedAttendance        Attendance[]      @relation("AttendanceEditor")
  machineWork             MachineRunEvent[] @relation("MachineEventWorker")
  machineEventsCreated    MachineRunEvent[] @relation("MachineEventCreator")
  devicePunches           DevicePunch[]
  machineLoads            MachineLoad[]     @relation("LoadWorker")
  expensesAsEmployee      Expense[]         @relation("ExpenseEmployee")
  stockSalesCreated       StockSale[]       @relation("StockSaleCreator")

  @@unique([organizationId, deviceUserId])
  @@index([organizationId])
}

enum Role {
  ADMIN
  MANAGER
  WORKER
}

// 3. Omborlar (Haqiqiy jismoniy joylar)
model Warehouse {
  id      String  @id @default(cuid())
  name    String
  address String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stockLevels   StockLevel[]
  movementsFrom StockMovement[] @relation("FromWarehouse")
  movementsTo   StockMovement[] @relation("ToWarehouse")
  rolls         Roll[]
  sales         Sale[]
  rawRuns       MachineRun[] @relation("RunRawWarehouse")
  goodsRuns     MachineRun[] @relation("RunGoodsWarehouse")

  @@index([organizationId])
}

// 4. Mahsulot va Xomashyo (Yagona model)
model Product {
  id            String  @id @default(cuid())
  name          String
  sku           String?
  unit          String  @default("dona")
  isRawMaterial Boolean @default(false)
  // Rulon (bobina) bilan hisoblanadimi? Faqat xomashyo uchun ma'noga ega.
  // Yoqilsa, ishlab chiqarishda ishchi aniq rulonni tanlashi shart bo'ladi.
  isRollTracked  Boolean @default(false)
  price          Decimal @default(0) @db.Decimal(15, 2)
  // O'rtacha tortilgan tannarx: kirim narxi va ishlab chiqarish (xomashyo + ishbay haq)
  // bo'yicha har bir kirimda qayta hisoblanadi
  costPrice      Decimal @default(0) @db.Decimal(15, 2)
  productionWage Decimal @default(0) @db.Decimal(15, 2)
  minStockLevel  Decimal @default(0) @db.Decimal(15, 2)
  // Ip (kalava) uchun: turi (Supreme, X/B, Sintetik) va rangi (Qora, Oq)
  yarnType       String?
  color          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bomItems   Bom[] @relation("FinishedProduct")
  usedInBoms Bom[] @relation("RawMaterial")

  stockLevels StockLevel[]
  movements   StockMovement[]
  saleItems   SaleItem[]
  rolls       Roll[]
  yarnRuns    MachineRun[] @relation("RunYarn")
  sockRuns    MachineRun[] @relation("RunProduct")
  loads       MachineLoad[] @relation("LoadYarn")
  batches     Batch[]       @relation("BatchYarn")
  yarnSales   StockSale[]   @relation("SaleYarn")

  @@index([organizationId])
  @@index([organizationId, isRawMaterial])
}

// 5. BOM (Recipe)
// Model nomi `Bom` — Prisma klienti `prisma.bom` sifatida ochadi.
// Jadval nomi @@map orqali "BOM" bo'lib qoladi.
model Bom {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation("FinishedProduct", fields: [productId], references: [id], onDelete: Cascade)
  materialId     String
  material       Product @relation("RawMaterial", fields: [materialId], references: [id], onDelete: Cascade)
  quantityNeeded Float

  @@unique([productId, materialId])
  @@index([productId])
  @@map("BOM")
}

// 6. Inventarizatsiya (Har bir ombor uchun alohida)
model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)

  @@unique([productId, warehouseId])
}

// 7. Harakatlar Auditi
model StockMovement {
  id       String       @id @default(cuid())
  type     MovementType
  quantity Float

  productId String
  product   Product @relation(fields: [productId], references: [id])

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  workerId String?
  worker   User?   @relation("WorkerMovements", fields: [workerId], references: [id])

  // Qaysi rulondan sarflandi (rulon bilan hisoblanadigan xomashyo uchun)
  rollId String?
  roll   Roll?   @relation(fields: [rollId], references: [id], onDelete: SetNull)

  // Bir birlik tannarxi shu harakat paytida (kirim narxi, ishlab chiqarish tannarxi, sotuv tannarxi)
  unitCost Decimal? @db.Decimal(15, 2)
  // Ishlab chiqarishdagi ishbay haq — keyin mahsulot narxi o'zgarsa ham tarix buzilmaydi
  unitWage Decimal? @db.Decimal(15, 2)

  // Kirim qaysi ta'minotchidan
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Sotuv yoki sotuvni bekor qilish harakati
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  // Stanok ishi (ip berish, sanash, qoldiqni qaytarish)
  machineRunId String?
  machineRun   MachineRun? @relation(fields: [machineRunId], references: [id], onDelete: SetNull)

  note           String?
  creatorId      String?
  creator        User?        @relation("CreatorMovements", fields: [creatorId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([supplierId])
  @@index([saleId])
  @@index([machineRunId])
}

// 8. Mato Rulonlari (Tikuv sehi uchun maxsus)
model Roll {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  initialWeight Float
  currentWeight Float
  status        RollStatus @default(AVAILABLE)

  movements StockMovement[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, productId, status])
}

enum RollStatus {
  AVAILABLE
  IN_USE
  FINISHED
}

// 9. Mijozlar
model Customer {
  id    String  @id @default(cuid())
  name  String
  phone String?
  // Musbat — mijoz bizdan qarz; manfiy — mijozning avansi (bekor qilingan sotuvdan keyin)
  debt  Decimal @default(0) @db.Decimal(15, 2)

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          Sale[]
  stockSales     StockSale[]
  debtPayments   DebtPayment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

// 9b. Qarz to'lovlari — mijoz qarzini yopgani auditi
model DebtPayment {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(15, 2)
  note   String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("DebtPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([customerId])
}

// 10. Ta'minotchilar — xomashyo kimdan olinadi va ularga qancha qarzmiz
model Supplier {
  id    String  @id @default(cuid())
  name  String
  phone String?
  note  String?
  // Biz ta'minotchiga qarzmiz (musbat)
  debt  Decimal @default(0) @db.Decimal(15, 2)

  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      StockMovement[]
  payments       SupplierPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
}

model SupplierPayment {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(15, 2)
  note   String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("SupplierPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([supplierId])
}

// 11. Sotuvlar
model Sale {
  id          String      @id @default(cuid())
  totalAmount Decimal     @db.Decimal(15, 2)
  paidAmount  Decimal     @db.Decimal(15, 2)
  paymentType PaymentType @default(CASH)
  status      SaleStatus  @default(ACTIVE)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Mahsulot qaysi ombordan chiqdi — bekor qilinganda shu yerga qaytadi
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  items     SaleItem[]
  movements StockMovement[]

  createdById String?
  createdBy   User?   @relation("SaleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?     @relation("SaleCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Float
  price     Decimal @db.Decimal(15, 2) // Sotilgan narxi (bir birlik)
  costPrice Decimal @db.Decimal(15, 2) // O'sha vaqtdagi tannarxi (bir birlik)
}

enum PaymentType {
  CASH
  CARD
  DEBT
}

enum SaleStatus {
  ACTIVE
  CANCELLED
}

// 12. Xarajatlar (operatsion: ijara, svet, transport...). Xomashyo xaridi bu yerga
// yozilmaydi — u tannarx orqali hisobotga tushadi.
model Expense {
  id       String  @id @default(cuid())
  amount   Decimal @db.Decimal(15, 2)
  category String
  note     String?

  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Ish haqi bo'lsa — qaysi xodimga
  employeeId String?
  employee   User?   @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// 13. Xodimlar Bonus/Jarima
model StaffAdjustment {
  id     String         @id @default(cuid())
  amount Decimal        @db.Decimal(15, 2)
  type   AdjustmentType
  note   String?

  userId String
  user   User   @relation("StaffAdjustments", fields: [userId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
}

enum AdjustmentType {
  BONUS
  PENALTY
}

enum MovementType {
  IN
  OUT
  PRODUCTION
  TRANSFER
  ADJUSTMENT
  WASTAGE
  REVISION
  RETURN
  // Ip stanokka berildi / stanokdan qaytdi
  TO_MACHINE
  FROM_MACHINE
}

// 14. Kirish va ro'yxatdan o'tish urinishlarini cheklash (serverless'da xotira
// umumiy emas, shuning uchun hisoblagich bazada)
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// 15. Davomat — har bir xodim uchun kuniga bitta yozuv (Toshkent kuni)
model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD, Toshkent vaqti bo'yicha
  date   String
  status AttendanceStatus @default(PRESENT)

  checkIn  DateTime?
  checkOut DateTime?
  // O'zi belgilaganda joylashuv va sexgacha masofa (metr) — nazorat uchun saqlanadi
  checkInLat        Float?
  checkInLng        Float?
  checkInDistanceM  Int?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutDistanceM Int?

  source AttendanceSource @default(SELF)
  note   String?

  // Menejer qo'lda kiritgan yoki tuzatgan bo'lsa
  editedById String?
  editedBy   User?   @relation("AttendanceEditor", fields: [editedById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, date])
  @@index([organizationId, date])
}

enum AttendanceStatus {
  PRESENT
  SICK
  VACATION
  EXCUSED
}

enum AttendanceSource {
  SELF
  MANAGER
  DEVICE
}

// 16. Stanoklar — paypoq to'quv mashinalari
model Machine {
  id       String  @id @default(cuid())
  number   Int
  // Guruh: bir xil turdagi stanoklar (masalan, "A" — 53 ta, "B" — 46 ta)
  group    String
  note     String?
  isActive Boolean @default(true)

  runs  MachineRun[]
  loads MachineLoad[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([organizationId])
}

// Stanok ishi: bitta ip, bitta model va bitta grammda — ip yoki model almashguncha ochiq
model MachineRun {
  id        String  @id @default(cuid())
  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  yarnId    String
  yarn      Product @relation("RunYarn", fields: [yarnId], references: [id])
  productId String
  product   Product @relation("RunProduct", fields: [productId], references: [id])
  // Bitta paypoq (dona) og'irligi, gramm
  gramsPerSock Float

  status       MachineRunStatus @default(OPEN)
  issuedKg     Float            @default(0)
  countedPairs Float            @default(0)
  // Yakunlanganda stanokda qolgan ip (omborga qaytadi)
  leftoverKg   Float?

  rawWarehouseId   String
  rawWarehouse     Warehouse @relation("RunRawWarehouse", fields: [rawWarehouseId], references: [id])
  goodsWarehouseId String
  goodsWarehouse   Warehouse @relation("RunGoodsWarehouse", fields: [goodsWarehouseId], references: [id])

  startedAt   DateTime  @default(now())
  closedAt    DateTime?
  startedById String?
  closedById  String?

  events    MachineRunEvent[]
  movements StockMovement[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([machineId, status])
}

enum MachineRunStatus {
  OPEN
  CLOSED
}

model MachineRunEvent {
  id       String           @id @default(cuid())
  runId    String
  run      MachineRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  type     MachineEventType
  // ISSUE/RETURN — kg, COUNT — juft
  quantity Float
  note     String?

  workerId    String?
  worker      User?   @relation("MachineEventWorker", fields: [workerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?   @relation("MachineEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([runId])
  @@index([organizationId, createdAt])
}

enum MachineEventType {
  ISSUE
  COUNT
  RETURN
}

// 17. Face ID qurilmalar (ZKTeco ADMS) va ulardan kelgan belgilar
model AttendanceDevice {
  id           String    @id @default(cuid())
  serialNumber String    @unique
  name         String
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?

  punches DevicePunch[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model DevicePunch {
  id        String           @id @default(cuid())
  deviceId  String
  device    AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Qurilmadagi xodim raqami
  pin       String
  punchedAt DateTime
  // Qurilma holati va tasdiqlash usuli (yuz, barmoq, karta) — xom ko'rinishda
  rawStatus Int?
  verify    Int?
  // Xodim topilgan bo'lsa davomatga yoziladi
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([deviceId, pin, punchedAt])
  @@index([organizationId, punchedAt])
}

// 18. Stanokka ip yuklash — belgilangan soatdan keyin avtomatik tayyor partiyaga o'tadi
model MachineLoad {
  id           String     @id @default(cuid())
  machineId    String
  machine      Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  yarnId       String
  yarn         Product    @relation("LoadYarn", fields: [yarnId], references: [id])
  // Bitta paypoq (dona) og'irligi, gramm
  gramsPerSock Float
  kg           Float
  status       LoadStatus @default(KNITTING)
  loadedAt     DateTime   @default(now())
  readyAt      DateTime
  doneAt       DateTime?

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  workerId    String?
  worker      User?   @relation("LoadWorker", fields: [workerId], references: [id], onDelete: SetNull)
  createdById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, readyAt])
  @@index([machineId, status])
}

enum LoadStatus {
  KNITTING
  DONE
  CANCELLED
}

// 19. Tayyor paypoq partiyasi: sana (omborga kelgan kun) + ip + gramm
model Batch {
  id           String  @id @default(cuid())
  // YYYY-MM-DD, Toshkent
  date         String
  yarnId       String
  yarn         Product @relation("BatchYarn", fields: [yarnId], references: [id])
  gramsPerSock Float
  // Hozir omborda: tayyor (qadoqlangan) va brak, kg
  finishedKg   Float   @default(0)
  defectKg     Float   @default(0)
  // Jami ishlab chiqarilgan, kg
  producedKg   Float   @default(0)

  loads     MachineLoad[]
  movements BatchMovement[]
  sales     StockSale[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date, yarnId, gramsPerSock])
  @@index([organizationId])
}

model BatchMovement {
  id      String            @id @default(cuid())
  batchId String
  batch   Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type    BatchMovementType
  kg      Float
  note    String?
  saleId  String?

  createdById    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([batchId])
  @@index([organizationId, createdAt])
}

enum BatchMovementType {
  PRODUCED
  DEFECT
  SALE
  SALE_CANCEL
}

// 20. Ombordan sotuv: ip yoki tayyor partiya (yoki brak) — kg va summa, nasiya bilan
model StockSale {
  id   String        @id @default(cuid())
  kind StockSaleKind

  yarnId  String?
  yarn    Product? @relation("SaleYarn", fields: [yarnId], references: [id])
  batchId String?
  batch   Batch?   @relation(fields: [batchId], references: [id])

  kg          Float
  totalAmount Decimal @db.Decimal(15, 2)
  paidAmount  Decimal @db.Decimal(15, 2)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  note       String?

  createdById String?
  createdBy   User?   @relation("StockSaleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

enum StockSaleKind {
  YARN
  FINISHED
  DEFECT
}
